# Root package: exposes Cargo.lock and Cargo.toml for the native crate_universe and release tooling;
# node_modules at root: npm link tree. App uses NODE_PATH = overlay/node_modules + node_modules (no full merge).
package(default_visibility = ["//visibility:public"])

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package")
load("@npm//:defs.bzl", "npm_link_all_packages")

exports_files([
    "Cargo.lock",
    "Cargo.toml",
    "LICENSE",
    "NOTICE",
    "package.json",
    "pnpm-workspace.yaml",
    "tsconfig.json",
])

filegroup(
    name = "example_notebooks",
    srcs = glob(
        ["examples/notebooks/**"],
        exclude = [
            "examples/notebooks/**/.DS_Store",
            "examples/notebooks/**/cache/**",
        ],
        allow_empty = False,
    ),
)

# Wrapper so other packages can use the root tsconfig in data.
js_library(
    name = "tsconfig_json",
    srcs = ["tsconfig.json"],
    visibility = ["//visibility:public"],
)

js_library(
    name = "example_notebooks_test_data",
    srcs = glob(
        ["examples/notebooks/**"],
        exclude = [
            "examples/notebooks/**/.DS_Store",
            "examples/notebooks/**/.gitignore",
            "examples/notebooks/**/cache/**",
        ],
        allow_empty = False,
    ),
)

# npm link tree from pnpm lockfile (package.bazel.json + pnpm-lock.yaml).
# Dashql-app uses this plus //packages/dashql-app:ankoh_overlay via NODE_PATH (two entries), no copy_to_directory merge.
npm_link_all_packages(name = "node_modules")

# The in-repo core package, linked like an npm dependency for Node consumers such as //packages/dashql-cli.
npm_link_package(
    name = "node_modules/@ankoh/dashql-core",
    src = "//packages/dashql-core-js:npm_package",
)
