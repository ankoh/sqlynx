{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dashql/app_manifest.json",
  "title": "StorageManifest",
  "description": "Manifest structure for DashQL notebooks (dashql-manifest.json)",
  "type": "object",
  "properties": {
    "notebooks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/NotebookEntry"
      },
      "description": "List of notebooks"
    },
    "appSettings": {
      "$ref": "#/definitions/AppSettings",
      "description": "Persisted app-level settings"
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ConnectionEntry"
      },
      "description": "The connections, the source of truth for the connection settings that notebooks replicate. Absent in manifests written before connections were global, an empty array means there are no connections."
    }
  },
  "required": ["notebooks"],
  "additionalProperties": false,
  "definitions": {
    "ConnectionEntry": {
      "type": "object",
      "description": "A connection that notebooks reference by its id",
      "properties": {
        "id": {
          "type": "string",
          "description": "The connection identifier (UUID), notebooks reference the connection with it"
        },
        "params": {
          "$ref": "connection.json#/definitions/ConnectionParams",
          "description": "The saved connection parameters, every notebook referencing the connection stores a copy"
        },
        "paramsDraft": {
          "$ref": "connection.json#/definitions/ConnectionParams",
          "description": "Unsaved edits of the connection parameters, including incomplete or invalid settings. Never replicated into notebooks."
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Identifiers of connections that were consolidated into this one. Notebooks referencing an alias are resolved to this connection."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the connection was created"
        }
      },
      "required": ["id", "params"],
      "additionalProperties": false
    },
    "NotebookEntry": {
      "type": "object",
      "description": "Manifest entry for a notebook",
      "properties": {
        "path": {
          "type": "string",
          "description": "The notebook identity as a bare notebook UUID."
        },
        "storageType": {
          "type": "string",
          "enum": ["opfs", "native"],
          "description": "Where this notebook's files live. Defaults to \"opfs\" when omitted (the OPFS root). \"native\" means the files live directly in `nativePath`. Mirrors the `storageType` field on the notebook itself."
        },
        "nativePath": {
          "type": "string",
          "description": "Absolute directory holding this notebook's files. Required when storageType is \"native\"; one directory holds exactly one notebook."
        }
      },
      "required": ["path"],
      "additionalProperties": false
    },
    "AppSettings": {
      "type": "object",
      "description": "Persisted app-level settings",
      "properties": {
        "pauseAfterAppSetup": {
          "type": "boolean"
        },
        "enableTableColumnPlots": {
          "type": "boolean"
        },
        "experimental_dashboards": {
          "type": "boolean"
        },
        "experimental_file_attachments": {
          "type": "boolean"
        },
        "narrowScreenLayout": {
          "type": "boolean"
        },
        "scriptDebugMode": {
          "type": "boolean"
        },
        "tableDebugMode": {
          "type": "boolean"
        },
        "formattingDebugMode": {
          "type": "boolean"
        },
        "keywordCase": {
          "type": "string",
          "enum": ["lower", "upper"]
        },
        "forceReLogin": {
          "type": "boolean"
        },
        "minLogLevel": {
          "type": "number"
        },
        "aiProvider": {
          "$ref": "#/definitions/AIProviderSettings",
          "description": "Configuration of the OpenAI-compatible AI provider"
        }
      },
      "additionalProperties": false
    },
    "AIProviderHeader": {
      "type": "object",
      "description": "Additional HTTP header sent with AI provider requests",
      "properties": {
        "name": {
          "type": "string",
          "description": "Header name"
        },
        "value": {
          "type": "string",
          "description": "Header value"
        }
      },
      "required": ["name", "value"],
      "additionalProperties": false
    },
    "AIProviderSettings": {
      "type": "object",
      "description": "Configuration for an OpenAI-compatible AI provider (Ollama, OpenAI, vLLM, etc.)",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether AI features are enabled"
        },
        "endpointUrl": {
          "type": "string",
          "description": "Base URL of the OpenAI-compatible server (e.g. http://localhost:11434)"
        },
        "model": {
          "type": "string",
          "description": "The model identifier to use for chat completions"
        },
        "headers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AIProviderHeader"
          },
          "description": "Additional HTTP headers (e.g. Authorization)"
        },
        "auth": {
          "$ref": "#/definitions/AIProviderAuth",
          "description": "How requests to the AI provider are authorized"
        }
      },
      "additionalProperties": false
    },
    "AIProviderAuth": {
      "type": "object",
      "description": "Authorization of AI provider requests, the credentials of every method are kept",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["none", "basic", "bearer"],
          "description": "The authorization method"
        },
        "username": {
          "type": "string",
          "description": "The username (for basic auth)"
        },
        "password": {
          "type": "string",
          "description": "The password (for basic auth)"
        },
        "token": {
          "type": "string",
          "description": "The token (for bearer auth)"
        }
      },
      "additionalProperties": false
    }
  }
}
