{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dashql/app_manifest.json",
  "title": "StorageManifest",
  "description": "Manifest structure for DashQL notebooks (dashql-manifest.json)",
  "type": "object",
  "properties": {
    "notebooks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/NotebookEntry"
      },
      "description": "List of notebooks"
    },
    "appSettings": {
      "$ref": "#/definitions/AppSettings",
      "description": "Persisted app-level settings"
    },
    "aiModels": {
      "$ref": "#/definitions/AIModels",
      "description": "The AI models, written by the atlas page as well and therefore not part of appSettings"
    }
  },
  "required": ["notebooks"],
  "additionalProperties": false,
  "definitions": {
    "NotebookEntry": {
      "type": "object",
      "description": "Manifest entry for a notebook",
      "properties": {
        "path": {
          "type": "string",
          "description": "The notebook identity as a bare notebook UUID."
        },
        "storageType": {
          "type": "string",
          "enum": ["opfs", "native"],
          "description": "Where this notebook's files live. Defaults to \"opfs\" when omitted (the OPFS root). \"native\" means the files live directly in `nativePath`. Mirrors the `storageType` field on the notebook itself."
        },
        "nativePath": {
          "type": "string",
          "description": "Absolute directory holding this notebook's files. Required when storageType is \"native\"; one directory holds exactly one notebook."
        }
      },
      "required": ["path"],
      "additionalProperties": false
    },
    "AppSettings": {
      "type": "object",
      "description": "Persisted app-level settings",
      "properties": {
        "pauseAfterAppSetup": {
          "type": "boolean"
        },
        "enableTableColumnPlots": {
          "type": "boolean"
        },
        "experimental_dashboards": {
          "type": "boolean"
        },
        "experimental_file_attachments": {
          "type": "boolean"
        },
        "narrowScreenLayout": {
          "type": "boolean"
        },
        "scriptDebugMode": {
          "type": "boolean"
        },
        "tableDebugMode": {
          "type": "boolean"
        },
        "formattingDebugMode": {
          "type": "boolean"
        },
        "keywordCase": {
          "type": "string",
          "enum": ["lower", "upper"]
        },
        "forceReLogin": {
          "type": "boolean"
        },
        "minLogLevel": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "AIModels": {
      "type": "object",
      "description": "The AI models and, per task, the model that runs it",
      "properties": {
        "config": {
          "$ref": "#/definitions/AIModelsConfig"
        },
        "tasks": {
          "$ref": "#/definitions/AITasks"
        }
      },
      "additionalProperties": false
    },
    "AIModelsConfig": {
      "type": "object",
      "description": "The models that can run tasks, the bundled model needs no configuration",
      "properties": {
        "external": {
          "$ref": "#/definitions/ExternalAIModel"
        }
      },
      "additionalProperties": false
    },
    "AITasks": {
      "type": "object",
      "description": "The model that every task runs on",
      "properties": {
        "describe": {
          "$ref": "#/definitions/AIModelChoice",
          "description": "Writing descriptions of scripts"
        },
        "embed": {
          "$ref": "#/definitions/AIModelChoice",
          "description": "Computing the embeddings of a semantic search"
        }
      },
      "additionalProperties": false
    },
    "AIModelChoice": {
      "type": "string",
      "enum": ["bundled", "external"],
      "description": "Whether a task runs on the model bundled with the app or on the external model"
    },
    "ExternalAIModel": {
      "type": "object",
      "description": "A model behind an OpenAI-compatible endpoint (Ollama, OpenAI, vLLM, etc.)",
      "properties": {
        "endpointUrl": {
          "type": "string",
          "description": "Base URL of the OpenAI-compatible server (e.g. http://localhost:11434)"
        },
        "model": {
          "type": "string",
          "description": "The model identifier"
        },
        "headers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AIModelHeader"
          },
          "description": "Additional HTTP headers (e.g. Authorization)"
        }
      },
      "additionalProperties": false
    },
    "AIModelHeader": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": ["name", "value"],
      "additionalProperties": false
    }
  }
}
