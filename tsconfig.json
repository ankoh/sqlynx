{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "sourceMap": true,
        "noImplicitAny": true,
        "isolatedModules": true,
        "strict": true,
        "jsx": "react-jsx",
        "paths": {
            "@ankoh/dashql-protobuf": [
                "./bazel-bin/packages/dashql-app/dependencies/dashql-protobuf"
            ],
            "@ankoh/dashql-protobuf/*": [
                "./bazel-bin/packages/dashql-app/dependencies/dashql-protobuf/*"
            ],
            "@ankoh/dashql-jsonschema": [
                "./bazel-bin/packages/dashql-app/dependencies/dashql-jsonschema"
            ],
            "@ankoh/dashql-jsonschema/*": [
                "./bazel-bin/packages/dashql-app/dependencies/dashql-jsonschema/*"
            ],
            "@ankoh/dashql-core": [
                "./bazel-bin/packages/dashql-core-js/dist/index.d.ts"
            ],
            "@ankoh/dashql-core/buffers": [
                "./bazel-bin/packages/dashql-core-js/dist/buffers.d.ts"
            ],
            "@ankoh/dashql-core/browser-worker": [
                "./bazel-bin/packages/dashql-core-js/dist/browser_worker.d.ts"
            ],
            "@ankoh/dashql-svg-symbols": [
                "./bazel-bin/packages/dashql-app/dependencies/svg-symbols/symbols.generated.svg"
            ],
            "@dashql/browser-test-act": [
                "./packages/dashql-app/src/tests/react_act.ts"
            ]
        },
        "types": [
            "node",
            "vitest/globals",
            "vite/client",
            "@webgpu/types"
        ],
        "lib": [
            "es6",
            "es2020",
            "dom"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "plugins": [
            {
                "name": "typescript-plugin-css-modules"
            }
        ]
    },
    "include": [
        "packages/dashql-app/src/**/*",
        "packages/dashql-app/test/**/*.ts",
        "packages/dashql-app/*.ts",
        "packages/dashql-app/bundles/*.ts",
        "packages/dashql-app/types/*.d.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
