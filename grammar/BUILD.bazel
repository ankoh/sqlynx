# The grammar of the dashql parser, compiled to Rust tables and actions for dashql_parser.

load("//grammar/rust:defs.bzl", "bison_rust_tables")

package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# Grammar files
# ---------------------------------------------------------------------------

filegroup(
    name = "prologue",
    srcs = ["prologue.y"],
)

filegroup(
    name = "epilogue",
    srcs = ["epilogue.y"],
)

filegroup(
    name = "precedences",
    srcs = ["precedences.y"],
)

filegroup(
    name = "keyword_lists",
    srcs = [
        "lists/sql_column_name_keywords.list",
        "lists/sql_reserved_keywords.list",
        "lists/sql_type_func_keywords.list",
        "lists/sql_unreserved_keywords.list",
        "lists/vis_unreserved_keywords.list",
    ],
)

filegroup(
    name = "type_files",
    srcs = [
        "rules/sql_create.yh",
        "rules/sql_delete.yh",
        "rules/sql_drop_attach.yh",
        "rules/sql_function.yh",
        "rules/sql_insert.yh",
        "rules/sql_pgq.yh",
        "rules/sql_select.yh",
        "rules/sql_view.yh",
        "rules/ext_explain.yh",
        "rules/ext_statement.yh",
        "rules/ext_set.yh",
        "rules/ext_varargs.yh",
        "rules/ext_visualize.yh",
    ],
)

filegroup(
    name = "rule_files",
    srcs = [
        "rules/sql_create.y",
        "rules/sql_delete.y",
        "rules/sql_drop_attach.y",
        "rules/sql_function.y",
        "rules/sql_insert.y",
        "rules/sql_pgq.y",
        "rules/sql_select.y",
        "rules/sql_view.y",
        "rules/ext_explain.y",
        "rules/ext_statement.y",
        "rules/ext_set.y",
        "rules/ext_varargs.y",
        "rules/ext_visualize.y",
    ],
)

# ---------------------------------------------------------------------------
# Grammar assembly (fragments -> dashql.y)
# ---------------------------------------------------------------------------

genrule(
    name = "grammar_y",
    srcs = [
        ":prologue",
        ":epilogue",
        ":precedences",
        ":keyword_lists",
        ":type_files",
        ":rule_files",
    ],
    outs = ["dashql.y"],
    cmd = (
        "python3 $(location assemble_grammar.py) " +
        "--output $(location dashql.y) " +
        "--prologue $(location :prologue) " +
        "--epilogue $(location :epilogue) " +
        "--precedences $(location :precedences) " +
        "--keyword_lists $(locations :keyword_lists) " +
        "--type_files $(locations :type_files) " +
        "--rule_files $(locations :rule_files)"
    ),
    tools = ["assemble_grammar.py"],
)

# ---------------------------------------------------------------------------
# Rust: the tables and actions of dashql.y, emitted through //grammar/rust:tables.rs.m4
# ---------------------------------------------------------------------------

bison_rust_tables(
    name = "parser_tables_rs",
    actions = True,
    grammar = ":grammar_y",
    out = "gen/rust/parser_tables.rs",
)

# The keyword table of the scanner, generated from the keyword lists of the grammar.
genrule(
    name = "keywords_rs",
    srcs = [":keyword_lists"],
    outs = ["gen/rust/keywords.rs"],
    cmd = "python3 $(location //grammar/rust:gen_keywords.py) --output $@ $(locations :keyword_lists)",
    tools = ["//grammar/rust:gen_keywords.py"],
)
