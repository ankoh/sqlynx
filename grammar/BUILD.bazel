# The grammar of the dashql parser, compiled to Rust tables and actions for dashql_grammar.

load("//grammar/rust:defs.bzl", "bison_rust_tables")

package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# Grammar files
# ---------------------------------------------------------------------------

filegroup(
    name = "prologue",
    srcs = ["prologue.y"],
)

filegroup(
    name = "epilogue",
    srcs = ["epilogue.y"],
)

filegroup(
    name = "precedences",
    srcs = ["precedences.y"],
)

filegroup(
    name = "keyword_lists",
    srcs = [
        "lists/sql_column_name_keywords.list",
        "lists/sql_reserved_keywords.list",
        "lists/sql_type_func_keywords.list",
        "lists/sql_unreserved_keywords.list",
        "lists/vis_unreserved_keywords.list",
    ],
)

filegroup(
    name = "type_files",
    srcs = [
        "rules/sql_create.yh",
        "rules/sql_delete.yh",
        "rules/sql_drop_attach.yh",
        "rules/sql_function.yh",
        "rules/sql_insert.yh",
        "rules/sql_pgq.yh",
        "rules/sql_select.yh",
        "rules/sql_view.yh",
        "rules/ext_explain.yh",
        "rules/ext_statement.yh",
        "rules/ext_set.yh",
        "rules/ext_varargs.yh",
        "rules/ext_visualize.yh",
    ],
)

filegroup(
    name = "rule_files",
    srcs = [
        "rules/sql_create.y",
        "rules/sql_delete.y",
        "rules/sql_drop_attach.y",
        "rules/sql_function.y",
        "rules/sql_insert.y",
        "rules/sql_pgq.y",
        "rules/sql_select.y",
        "rules/sql_view.y",
        "rules/ext_explain.y",
        "rules/ext_statement.y",
        "rules/ext_set.y",
        "rules/ext_varargs.y",
        "rules/ext_visualize.y",
    ],
)

# ---------------------------------------------------------------------------
# Rust: the grammar with Rust actions (translated from rules/*.y by rust/translate_actions.py),
# emitted through //grammar/rust:tables.rs.m4.
# ---------------------------------------------------------------------------

# The Rust rule set is translated from the C++ actions of rules/*.y.
RULE_NAMES = [
    "ext_explain",
    "ext_set",
    "ext_statement",
    "ext_varargs",
    "ext_visualize",
    "sql_create",
    "sql_delete",
    "sql_drop_attach",
    "sql_function",
    "sql_insert",
    "sql_pgq",
    "sql_select",
    "sql_view",
]

genrule(
    name = "rust_rule_files",
    srcs = [":rule_files"],
    outs = ["rules_rs/%s.y" % name for name in RULE_NAMES],
    cmd = "python3 $(location //grammar/rust:translate_actions.py) --output_dir $(RULEDIR)/rules_rs $(locations :rule_files)",
    tools = ["//grammar/rust:translate_actions.py"],
)

genrule(
    name = "grammar_rs_y",
    srcs = [
        ":prologue",
        ":epilogue",
        ":precedences",
        ":keyword_lists",
        ":type_files",
        ":rust_rule_files",
    ],
    outs = ["dashql_rs.y"],
    cmd = (
        "python3 $(location assemble_grammar.py) --lang rust " +
        "--output $(location dashql_rs.y) " +
        "--prologue $(location :prologue) " +
        "--epilogue $(location :epilogue) " +
        "--precedences $(location :precedences) " +
        "--keyword_lists $(locations :keyword_lists) " +
        "--type_files $(locations :type_files) " +
        "--rule_files $(locations :rust_rule_files)"
    ),
    tools = ["assemble_grammar.py"],
)

bison_rust_tables(
    name = "parser_tables_rs",
    actions = True,
    grammar = ":grammar_rs_y",
    out = "gen/rust/parser_tables.rs",
)

# The keyword table of the scanner, generated from the keyword lists of the grammar.
genrule(
    name = "keywords_rs",
    srcs = [":keyword_lists"],
    outs = ["gen/rust/keywords.rs"],
    cmd = "python3 $(location //grammar/rust:gen_keywords.py) --output $@ $(locations :keyword_lists)",
    tools = ["//grammar/rust:gen_keywords.py"],
)
