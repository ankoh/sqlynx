# Header-only library shared by dashql_core (native) and dashql_core_wasm.
# exclude include/dashql/buffers/*.h: generated by bazel, remove once cmake is gone
cc_library(
    name = "dashql_core_headers",
    hdrs = glob(
        ["include/**/*.h"],
        exclude = [
            "include/dashql/buffers/*.h",
            "include/dashql/shell/*.h",
        ],
    ),
    includes = ["include"],
)

# Shared deps for native dashql_core and WASM build (parser_generated_wasm, dashql_core_wasm).
CORE_DEPS = [
    "//grammar:grammar_lists_include",
    "//grammar:parser_generated_headers",
    "//packages/dashql-core/vendor/frozen:frozen",
    "//packages/dashql-core/vendor/utf8proc:utf8proc",
    "//proto/fb:dashql_buffers_cc",
    ":dashql_core_headers",
    "@ankerl_unordered_dense//:ankerl",
    "@com_google_flatbuffers//:flatbuffers",
    "@md4c//:md4c",
    "@rapidjson//:rapidjson",
]

cc_library(
    name = "scanner_generated_native",
    srcs = ["//grammar:scanner_generated"],
    copts = DASHQL_COPTS,
    deps = CORE_DEPS,
)

cc_library(
    name = "dashql_core",
    srcs = LIB_SRCS + [
        "//grammar:parser_generated",
    ],
    copts = DASHQL_COPTS,
    linkopts = DASHQL_LINKOPTS,
    deps = [":scanner_generated_native"] + CORE_DEPS,
    visibility = ["//visibility:public"],
)

# ---------------------------------------------------------------------------
# WASM binary (build with: bazel build //packages/dashql-core:core_wasm)
# ---------------------------------------------------------------------------

# Bison-generated parser is compiled with -O1 only (see :parser_generated_wasm) to avoid
# "local count too large" in V8/Node; rest stays unoptimized (CMake: set_source_files_properties(parser_generated.cc COMPILE_OPTIONS "-O1")).

WASM_COPTS = [
    "-std=c++20",
    "-DWASM=1",
    "-DFLATBUFFERS_NO_ABSOLUTE_PATH_RESOLUTION",
    "-Wno-deprecated-declarations",
    "-fconstexpr-steps=100000000",
    "-mbulk-memory",
]
WASM_LINKOPTS = dashql_wasm_linkopts(CORE_WASM_EXPORTS, 67108864, "web,node,worker", 2147483648) + [
    "-sSTACK_SIZE=1048576",
]
# Parser generated .cc compiled with -O1 only (bison output has huge local count at -O0).
cc_library(
    name = "parser_generated_wasm",
    srcs = ["//grammar:gen/include/dashql/parser/parser_generated.cc"],
    copts = WASM_COPTS + ["-O1"],
    features = ["wasm_exceptions", "wasm_simd"],
    target_compatible_with = ["@platforms//cpu:wasm32"],
    deps = CORE_DEPS,
)

cc_library(
    name = "scanner_generated_wasm",
    srcs = ["//grammar:scanner_generated"],
    copts = WASM_COPTS,
    features = ["wasm_exceptions", "wasm_simd"],
    target_compatible_with = ["@platforms//cpu:wasm32"],
    deps = [":parser_generated_wasm"] + CORE_DEPS,
)

cc_library(
    name = "dashql_core_wasm_library",
    srcs = LIB_SRCS,
    copts = WASM_COPTS,
    features = ["wasm_exceptions", "wasm_simd"],
    target_compatible_with = ["@platforms//cpu:wasm32"],
    deps = [
        ":parser_generated_wasm",
        ":scanner_generated_wasm",
    ] + CORE_DEPS,
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "dashql_core_wasm",
    srcs = LIB_SRCS,
    copts = WASM_COPTS,
    features = ["wasm_exceptions", "wasm_simd"],
    linkopts = WASM_LINKOPTS,
    tags = ["manual"],
    target_compatible_with = ["@platforms//cpu:wasm32"],
    deps = [
        ":parser_generated_wasm",
        ":scanner_generated_wasm",
    ] + CORE_DEPS,
)

wasm_cc_binary(
    name = "core_wasm",
    cc_target = ":dashql_core_wasm",
    standalone = False,
    outputs = [
        "dashql_core.wasm",
        "dashql_core.js",
    ],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# ---------------------------------------------------------------------------
# Shell library and combined Core+Shell WASM binary.
# ---------------------------------------------------------------------------

SHELL_COPTS = [
    "-std=c++20",
    "-fexceptions",
    "-Wno-deprecated-declarations",
]

SHELL_WASM_COPTS = SHELL_COPTS + [
    "-DWASM=1",
    "-mbulk-memory",
]

SHELL_WASM_LINKOPTS = dashql_wasm_linkopts(
    CORE_WASM_EXPORTS + SHELL_WASM_EXPORTS,
    33554432,
    "web,node,worker",
    2147483648,
    "createDashQLShellModule",
) + ["-sSTACK_SIZE=1048576"]

cc_library(
    name = "dashql_shell",
