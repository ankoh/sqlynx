{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noImplicitAny": true,
        "esModuleInterop": false,
        "downlevelIteration": true,
        "isolatedModules": true,
        "ignoreDeprecations": "6.0",
        "strict": true,
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@ankoh/dashql-core": ["./dependencies/dashql-core/dist/index.d.ts"],
            "@ankoh/dashql-core/buffers": ["./dependencies/dashql-core/dist/buffers.d.ts"],
            "@ankoh/dashql-core/browser-worker": ["./dependencies/dashql-core/dist/browser_worker.d.ts"],
            "@ankoh/dashql-protobuf": ["./dependencies/dashql-protobuf"],
            "@ankoh/dashql-protobuf/*": ["./dependencies/dashql-protobuf/*"],
            "@ankoh/dashql-jsonschema": ["./dependencies/dashql-jsonschema"],
            "@ankoh/dashql-jsonschema/*": ["./dependencies/dashql-jsonschema/*"],
            "@dashql/browser-test-act": ["./src/tests/react_act.ts"]
        },
        "types": ["node", "vitest/globals", "vite/client", "@webgpu/types"],
        "lib": ["es6", "es2020", "dom"],
        "allowJs": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*",
        "types/**/*"
    ]
}
