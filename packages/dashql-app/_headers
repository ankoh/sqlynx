/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Access-Control-Allow-Origin: *

# Published session examples are mutable source files. Never reuse them without a new request.
/static/examples/sessions/*
  Cache-Control: no-store, max-age=0, must-revalidate

# Vite fingerprints files in these output directories. Their URLs change with their contents, so
# browsers can retain successful responses across deployments. Keep mutable static/config.json and
# published sessions outside these rules.
/static/assets/*
  Cache-Control: public, max-age=31536000, immutable

/static/css/*
  Cache-Control: public, max-age=31536000, immutable

/static/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/static/img/*
  Cache-Control: public, max-age=31536000, immutable

/static/js/*
  Cache-Control: public, max-age=31536000, immutable

/static/scripts/*
  Cache-Control: public, max-age=31536000, immutable

/static/wasm/*
  Cache-Control: public, max-age=31536000, immutable

# Serve uncompressed WebAssembly with the MIME type required for streaming compilation.
/static/wasm/*.wasm
  Content-Type: application/wasm

# The pages build compresses all WebAssembly with Brotli (precompressWasm in vite.config.tpl.ts) and keeps the
# `.br` suffix. The browser decompresses it before fetch() and WebAssembly.instantiateStreaming() see it.
/static/wasm/*.br
  Content-Encoding: br
  Content-Type: application/wasm

# Vite preserves the .br suffix but inserts the content hash before it.
/static/assets/hyperdb-wasm.wasm.*.br
  Content-Encoding: br
  Content-Type: application/wasm

# Native release artifacts are versioned and immutable when hosted by this project.
/releases/*
  Cache-Control: public, max-age=31536000, immutable

# Entrypoints must be revalidated before reuse.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/oauth.html
  Cache-Control: public, max-age=0, must-revalidate

/oauth
  Cache-Control: public, max-age=0, must-revalidate

/shell.html
  Cache-Control: public, max-age=0, must-revalidate

/tests.html
  Cache-Control: public, max-age=0, must-revalidate

/tests-frame.html
  Cache-Control: public, max-age=0, must-revalidate
