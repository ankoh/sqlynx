load("@rules_rust//rust:defs.bzl", "rust_binary")
load(":datasets.bzl", "declare_datasets", "tpch_extension_repo_name")

# The vendored TPC-H extension, selected per exec platform. Unlike //bazel:duckdb_cli
# (whose macOS zip is universal, so it branches on OS only), the extension is arch-
# specific — a build compiled for osx_arm64 will not load into an x86_64 process — so
# we branch on OS × CPU. Names match DuckDB's `PRAGMA platform` (see TPCH_EXTENSION_SHA256).
[
    config_setting(
        name = "is_" + platform,
        constraint_values = constraints,
    )
    for platform, constraints in {
        "osx_arm64": ["@platforms//os:macos", "@platforms//cpu:arm64"],
        "osx_amd64": ["@platforms//os:macos", "@platforms//cpu:x86_64"],
        "linux_amd64": ["@platforms//os:linux", "@platforms//cpu:x86_64"],
        "linux_arm64": ["@platforms//os:linux", "@platforms//cpu:arm64"],
    }.items()
]

alias(
    name = "tpch_extension",
    actual = select({
        ":is_osx_arm64": "@" + tpch_extension_repo_name("osx_arm64") + "//file",
        ":is_osx_amd64": "@" + tpch_extension_repo_name("osx_amd64") + "//file",
        ":is_linux_amd64": "@" + tpch_extension_repo_name("linux_amd64") + "//file",
        ":is_linux_arm64": "@" + tpch_extension_repo_name("linux_arm64") + "//file",
    }),
    visibility = ["//visibility:public"],
)

# The indexer + R2 mirror. `index` runs inside the hermetic build (below); `sync`
# runs via the :sync target. Client/deps mirror dashql-pack but stay independent.
rust_binary(
    name = "dashql-datasets",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    deps = [
        "@crates//:anyhow",
        "@crates//:aws-config",
        "@crates//:aws-credential-types",
        "@crates//:aws-sdk-s3",
        "@crates//:clap",
        "@crates//:env_logger",
        "@crates//:log",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tokio",
        "@crates//:walkdir",
    ],
    visibility = ["//visibility:public"],
)

# Expand DATASETS: convert genrules (DuckDB CLI -> Parquet), the assembled versioned
# tree, index.json, and the final :datasets artifact (Parquet + index.json).
declare_datasets(
    name = "datasets",
    index_tool = ":dashql-datasets",
)

# Ergonomic run target: build the hermetic tree, then mirror it to R2.
#   bazel run //packages/dashql-datasets:sync            (upload)
#   bazel run //packages/dashql-datasets:sync -- --dry-run
# Marked manual so it stays out of wildcard builds (like dashql-pack:publish).
rust_binary(
    name = "sync",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    args = [
        "sync",
        "--dir",
        "$(rootpath :datasets)",
    ],
    data = [":datasets"],
    tags = ["manual"],
    deps = [
        "@crates//:anyhow",
        "@crates//:aws-config",
        "@crates//:aws-credential-types",
        "@crates//:aws-sdk-s3",
        "@crates//:clap",
        "@crates//:env_logger",
        "@crates//:log",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tokio",
        "@crates//:walkdir",
    ],
    visibility = ["//visibility:public"],
)
