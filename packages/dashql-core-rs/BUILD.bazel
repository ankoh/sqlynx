# Regenerates snapshots/**/*.yaml from the templates *.tpl.yaml, byte for byte like the former C++ snapshotter.
# bazel run //snapshots/<category>:update, or directly:
#   bazel run //packages/dashql-core-rs:snapshotter -- --source_dir=$PWD [--filter=<category>]
rust_binary(
    name = "snapshotter",
    testonly = True,
    srcs = ["dashql-snapshots/src/bin/snapshotter.rs"],
    edition = "2021",
    # Snapshot generation runs the whole pipeline over large scripts (TPC-DS), always optimize
    rustc_flags = ["-Copt-level=3"],
    visibility = ["//snapshots:__subpackages__"],
    deps = [
        ":dashql_core",
        ":dashql_grammar",
        ":dashql_snapshots",
        "//proto/fb:dashql_buffers_rs",
    ],
)

