# ---------------------------------------------------------------------------
# Shell: the wasm bindings of the core and the shell wasm module.
# ---------------------------------------------------------------------------

# The wasm-bindgen items of the core, shared by the core and the shell module.
rust_library(
    name = "dashql_core_wasm_lib",
    srcs = glob(["dashql-core-wasm/src/**/*.rs"]),
    crate_name = "dashql_core_wasm_lib",
    crate_root = "dashql-core-wasm/src/lib.rs",
    edition = "2021",
    target_compatible_with = ["@platforms//cpu:wasm32"],
    deps = [
        ":dashql_core",
        ":dashql_grammar",
        "//proto/fb:dashql_buffers_rs",
        "@core_crates//:flatbuffers",
        "@core_crates//:wasm-bindgen",
    ],
)

# The shell wasm module: the core bindings and the shell.
rust_shared_library(
    name = "dashql_shell_wasm",
    srcs = glob(["dashql-shell-wasm/src/**/*.rs"]),
    crate_name = "dashql_shell_wasm",
    edition = "2021",
    target_compatible_with = ["@platforms//cpu:wasm32"],
    deps = [
        ":dashql_core",
        ":dashql_core_wasm_lib",
        "@core_crates//:wasm-bindgen",
    ],
)

rust_wasm_bindgen(
    name = "dashql_shell_bindgen",
    visibility = ["//visibility:public"],
    out_name = "dashql_shell",
    target = "web",
    wasm_file = ":dashql_shell_wasm",
)

wasm_bindgen_module(
    name = "dashql_shell_bindgen_wasm",
    bindgen = ":dashql_shell_bindgen",
)

# Release: wasm-opt -O3 + strip; dev: copy through unchanged.
optimize_wasm(
    name = "shell_wasm",
    visibility = ["//visibility:public"],
    src = ":dashql_shell_bindgen_wasm",
    out = "dashql_shell_bg.wasm",
)
