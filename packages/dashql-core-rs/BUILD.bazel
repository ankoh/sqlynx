# Rust rewrite of dashql-core. Plan and status: docs/rust-port/README.md.
#
#   dashql_grammar    LALR(1) tables of //grammar emitted through //grammar/rust:tables.rs.m4
#                     (later: scanner, parse context, LR driver)
#   dashql_snapshots  loads the shared //snapshots YAML files for libtest-mimic trials
#   dashql_oracle     the C++ core linked natively as a differential test oracle
#   dashql_buffers    FlatBuffers bindings, see //proto/fb:dashql_buffers_rs
#   core_wasm         the wasm-bindgen module (phase 0: grammar only, tracks the module size)
#
# All third-party crates resolve from the isolated @core_crates universe (MODULE.bazel).

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_shared_library", "rust_test")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen")
load("//bazel:wasm_tools.bzl", "optimize_wasm", "wasm_bindgen_module")
load("//grammar/rust:defs.bzl", "bison_rust_tables")

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

# ---------------------------------------------------------------------------
# dashql-grammar
# ---------------------------------------------------------------------------

# rules_rust places generated sources next to the checked-in ones only if they belong to the same
# package, copy the generated modules of //grammar into the crate.
genrule(
    name = "dashql_grammar_tables_rs",
    srcs = ["//grammar:parser_tables_rs"],
    outs = ["dashql-grammar/src/tables.rs"],
    cmd = "cp $< $@",
)

genrule(
    name = "dashql_grammar_keywords_rs",
    srcs = ["//grammar:keywords_rs"],
    outs = ["dashql-grammar/src/keywords/table.rs"],
    cmd = "cp $< $@",
)

rust_library(
    name = "dashql_grammar",
    srcs = glob(["dashql-grammar/src/**/*.rs"]) + [
        ":dashql_grammar_keywords_rs",
        ":dashql_grammar_tables_rs",
    ],
    crate_name = "dashql_grammar",
    crate_root = "dashql-grammar/src/lib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//proto/fb:dashql_buffers_rs",
        "@core_crates//:serde_json",
    ],
)

rust_test(
    name = "dashql_grammar_unit_tests",
    size = "small",
    crate = ":dashql_grammar",
)

# The Rust tables must be the automaton of the C++ parser.
rust_test(
    name = "dashql_grammar_table_parity_test",
    size = "small",
    srcs = ["dashql-grammar/tests/table_parity.rs"],
    data = [
        "//grammar:gen/include/dashql/parser/parser_generated.cc",
        "//grammar:gen/include/dashql/parser/parser_generated.h",
    ],
    edition = "2021",
    env = {
        "CXX_PARSER_GENERATED_CC": "$(rootpath //grammar:gen/include/dashql/parser/parser_generated.cc)",
        "CXX_PARSER_GENERATED_H": "$(rootpath //grammar:gen/include/dashql/parser/parser_generated.h)",
    },
    deps = [":dashql_grammar"],
)

# A calculator grammar with Rust actions exercises the action path of the skeleton.
bison_rust_tables(
    name = "calc_tables_rs",
    actions = True,
    grammar = "dashql-grammar/tests/calc.y",
    out = "dashql-grammar/tests/calc_tables.rs",
)

rust_test(
    name = "dashql_grammar_skeleton_test",
    size = "small",
    srcs = [
        "dashql-grammar/tests/calc_test.rs",
        ":calc_tables_rs",
    ],
    crate_root = "dashql-grammar/tests/calc_test.rs",
    edition = "2021",
)

# ---------------------------------------------------------------------------
# dashql-core
# ---------------------------------------------------------------------------

rust_library(
    name = "dashql_core",
    srcs = glob(["dashql-core/src/**/*.rs"]),
    crate_name = "dashql_core",
    crate_root = "dashql-core/src/lib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        ":dashql_grammar",
        "//proto/fb:dashql_buffers_rs",
        "@core_crates//:flatbuffers",
        "@core_crates//:serde_json",
    ],
)

rust_test(
    name = "dashql_core_unit_tests",
    size = "small",
    crate = ":dashql_core",
)

# Snapshot tests of the core: one target per category, each a libtest-mimic binary.
DASHQL_CORE_SNAPSHOT_TESTS = {
    "formatter_snapshot_test": ("formatter_snapshots.rs", "//snapshots/formatter:files"),
    "analyzer_snapshot_test": ("analyzer_snapshots.rs", "//snapshots/analyzer:files"),
    "diff_snapshot_test": ("diff_snapshots.rs", "//snapshots:files"),
    "plan_view_model_snapshot_test": ("plan_view_model_snapshots.rs", "//snapshots/plans/hyper/tests:files"),
}

[rust_test(
    name = name,
    size = "small",
    srcs = ["dashql-core/tests/" + src],
    data = [data],
    edition = "2021",
    use_libtest_harness = False,
    deps = [
        ":dashql_core",
        ":dashql_grammar",
        ":dashql_oracle",
        ":dashql_snapshots",
        "//proto/fb:dashql_buffers_rs",
        "@core_crates//:flatbuffers",
        "@core_crates//:serde_json",
    ],
) for name, (src, data) in DASHQL_CORE_SNAPSHOT_TESTS.items()]

# ---------------------------------------------------------------------------
# dashql-buffers (generated by //proto/fb:dashql_buffers_rs)
# ---------------------------------------------------------------------------

# The Rust bindings must agree with the enum invariants the C++ core relies on.
rust_test(
    name = "dashql_buffers_test",
    size = "small",
    srcs = ["dashql-buffers/tests/enums.rs"],
    edition = "2021",
    deps = [
        "//proto/fb:dashql_buffers_rs",
        "@core_crates//:flatbuffers",
    ],
)

# ---------------------------------------------------------------------------
# dashql-snapshots
# ---------------------------------------------------------------------------

rust_library(
    name = "dashql_snapshots",
    testonly = True,
    srcs = glob(["dashql-snapshots/src/**/*.rs"]),
    crate_name = "dashql_snapshots",
    crate_root = "dashql-snapshots/src/lib.rs",
    edition = "2021",
    deps = [
        ":dashql_core",
        ":dashql_grammar",
        "//proto/fb:dashql_buffers_rs",
        "@core_crates//:libtest-mimic",
        "@core_crates//:yaml-rust2",
    ],
)

rust_test(
    name = "dashql_snapshots_unit_tests",
    size = "small",
    crate = ":dashql_snapshots",
)

# ---------------------------------------------------------------------------
# dashql-oracle
# ---------------------------------------------------------------------------

rust_library(
    name = "dashql_oracle",
    testonly = True,
    srcs = glob(
        ["dashql-oracle/src/**/*.rs"],
        exclude = ["dashql-oracle/src/bin/**"],
    ),
    crate_name = "dashql_oracle",
    crate_root = "dashql-oracle/src/lib.rs",
    edition = "2021",
    deps = ["//packages/dashql-core:oracle_ffi"],
)

# Query the oracle from the command line: bazel run //packages/dashql-core-rs:oracle -- scan "select 1"
rust_binary(
    name = "oracle",
    testonly = True,
    srcs = ["dashql-oracle/src/bin/oracle.rs"],
    edition = "2021",
    deps = [":dashql_oracle"],
)

rust_test(
    name = "dashql_oracle_unit_tests",
    size = "small",
    crate = ":dashql_oracle",
)

# Replays all parser snapshots through the C++ oracle (validates harness and oracle).
rust_test(
    name = "oracle_parser_snapshot_test",
    size = "small",
    srcs = ["dashql-oracle/tests/parser_snapshots.rs"],
    data = ["//snapshots/parser:files"],
    edition = "2021",
    use_libtest_harness = False,
    deps = [
        ":dashql_oracle",
        ":dashql_snapshots",
    ],
)

# ---------------------------------------------------------------------------
# dashql-core-wasm: the wasm-bindgen module (same pipeline as //packages/dashql-umap)
# ---------------------------------------------------------------------------

rust_shared_library(
    name = "dashql_core_wasm",
    srcs = glob(["dashql-core-wasm/src/**/*.rs"]),
    crate_name = "dashql_core_wasm",
    edition = "2021",
    target_compatible_with = ["@platforms//cpu:wasm32"],
    deps = [
        ":dashql_grammar",
        "@core_crates//:wasm-bindgen",
    ],
)

# The wasm_file attribute transitions to wasm32, independent of the host --platforms.
rust_wasm_bindgen(
    name = "dashql_core_bindgen",
    out_name = "dashql_core",
    target = "web",
    wasm_file = ":dashql_core_wasm",
)

wasm_bindgen_module(
    name = "dashql_core_bindgen_wasm",
    bindgen = ":dashql_core_bindgen",
)

# Release: wasm-opt -O3 + strip; dev: copy through unchanged.
optimize_wasm(
    name = "core_wasm",
    src = ":dashql_core_bindgen_wasm",
    out = "dashql_core_bg.wasm",
)

# The Rust scanner must produce exactly the output of the C++ scanner: all snapshot inputs, their
# prefixes, and deterministic fuzz inputs.
rust_test(
    name = "scanner_differential_test",
    size = "medium",
    srcs = ["dashql-oracle/tests/scanner_differential.rs"],
    data = ["//snapshots:files"],
    edition = "2021",
    use_libtest_harness = False,
    deps = [
        ":dashql_grammar",
        ":dashql_oracle",
        ":dashql_snapshots",
    ],
)

# The Rust parser must produce exactly the output of the C++ parser: all snapshot inputs, their
# prefixes, random sentences of the grammar, and deterministic fuzz inputs.
rust_test(
    name = "parser_differential_test",
    size = "medium",
    srcs = ["dashql-oracle/tests/parser_differential.rs"],
    data = ["//snapshots:files"],
    edition = "2021",
    use_libtest_harness = False,
    deps = [
        ":dashql_grammar",
        ":dashql_oracle",
        ":dashql_snapshots",
    ],
)

# The parser snapshots, produced by the Rust parser.
rust_test(
    name = "parser_snapshot_test",
    size = "small",
    srcs = ["dashql-snapshots/tests/parser_snapshots.rs"],
    data = ["//snapshots/parser:files"],
    edition = "2021",
    use_libtest_harness = False,
    deps = [
        ":dashql_grammar",
        ":dashql_snapshots",
    ],
)

# ---------------------------------------------------------------------------
# Benchmarks (bazel run -c opt //packages/dashql-core-rs:bench_pipeline)
# ---------------------------------------------------------------------------

rust_binary(
    name = "bench_pipeline",
    srcs = ["benches/pipeline.rs"],
    edition = "2021",
    deps = [
        ":dashql_core",
        ":dashql_grammar",
        "//proto/fb:dashql_buffers_rs",
    ],
)

# The Rust formatter must produce exactly the output of the C++ formatter: all snapshot inputs and
# their prefixes, and deterministic fuzz inputs, across modes, dialects, keyword cases and widths.
rust_test(
    name = "formatter_differential_test",
    size = "medium",
    srcs = ["dashql-oracle/tests/formatter_differential.rs"],
    data = ["//snapshots:files"],
    edition = "2021",
    use_libtest_harness = False,
    deps = [
        ":dashql_core",
        ":dashql_grammar",
        ":dashql_oracle",
        ":dashql_snapshots",
        "//proto/fb:dashql_buffers_rs",
    ],
)

# The Rust plan view model must produce exactly the output of the C++ plan view model: all snapshot plans under
# several layout configs, their prefixes, mutations, handwritten plans and random operator trees.
rust_test(
    name = "plan_view_model_differential_test",
    size = "medium",
    srcs = ["dashql-oracle/tests/plan_view_model_differential.rs"],
    data = ["//snapshots/plans/hyper/tests:files"],
    edition = "2021",
    use_libtest_harness = False,
    deps = [
        ":dashql_core",
        ":dashql_oracle",
        ":dashql_snapshots",
        "//proto/fb:dashql_buffers_rs",
        "@core_crates//:flatbuffers",
    ],
)

# The Rust analyzer must produce exactly the output of the C++ analyzer: the analyzer snapshot cases, all
# snapshot inputs alone and against snapshot catalogs, their prefixes, and fuzzed scripts and catalogs.
rust_test(
    name = "analyzer_differential_test",
    size = "medium",
    srcs = ["dashql-oracle/tests/analyzer_differential.rs"],
    data = ["//snapshots:files"],
    edition = "2021",
    use_libtest_harness = False,
    deps = [
        ":dashql_oracle",
        ":dashql_snapshots",
    ],
)
