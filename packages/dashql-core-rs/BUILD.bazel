# ---------------------------------------------------------------------------
# dashql-core-wasm: the wasm-bindgen module (same pipeline as //packages/dashql-umap)
# ---------------------------------------------------------------------------

# The bindings live in an rlib (:dashql_core_wasm_lib, see the end of the file) that the core and the shell
# modules re-export.
rust_shared_library(
    name = "dashql_core_wasm",
    srcs = ["dashql-core-wasm/cdylib.rs"],
    crate_name = "dashql_core_wasm",
    crate_root = "dashql-core-wasm/cdylib.rs",
    edition = "2021",
    target_compatible_with = ["@platforms//cpu:wasm32"],
    deps = [
        ":dashql_core_wasm_lib",
        "@core_crates//:wasm-bindgen",
    ],
)

# The wasm_file attribute transitions to wasm32, independent of the host --platforms.
rust_wasm_bindgen(
    name = "dashql_core_bindgen",
    out_name = "dashql_core",
    target = "web",
    visibility = ["//visibility:public"],
    wasm_file = ":dashql_core_wasm",
)

wasm_bindgen_module(
    name = "dashql_core_bindgen_wasm",
    bindgen = ":dashql_core_bindgen",
)

# Release: wasm-opt -O3 + strip; dev: copy through unchanged.
optimize_wasm(
    name = "core_wasm",
    src = ":dashql_core_bindgen_wasm",
    out = "dashql_core_bg.wasm",
    visibility = ["//visibility:public"],
)

