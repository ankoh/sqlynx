load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:typescript/package_json.bzl", typescript_bin = "bin")
load("@npm//:vitest/package_json.bzl", vitest_bin = "bin")

package(default_visibility = ["//visibility:private"])

exports_files(["package.json"])

filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.ts"]),
)

# Everything that ships in the CLI, without tests
filegroup(
    name = "lib_srcs",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["src/**/*.test.ts"],
    ),
)

js_library(
    name = "test_srcs",
    srcs = [
        ":srcs",
        "package.json",
        "tsconfig.bazel.json",
    ],
)

_RUNTIME_DEPS = [
    "//:node_modules/@ankoh/dashql-core",
]

typescript_bin.tsc_binary(
    name = "tsc_bin",
)

ts_project(
    name = "compile",
    # package.json is an input so that tsc sees `"type": "module"` for NodeNext module detection
    srcs = [
        ":lib_srcs",
        "package.json",
    ],
    out_dir = "dist",
    root_dir = "src",
    source_map = True,
    tsconfig = "tsconfig.bazel.json",
    tsc = ":tsc_bin",
    tsc_worker = ":tsc_bin",
    transpiler = "tsc",
    validate = False,
    validator = ":tsc_bin",
    deps = _RUNTIME_DEPS + ["//:node_modules/@types/node"],
    visibility = ["//visibility:public"],
)

# bazel run //packages/dashql-lint:cli -- <file.sql|dir|->...
js_binary(
    name = "cli",
    data = [
        ":compile",
        ":package.json",
    ] + _RUNTIME_DEPS,
    entry_point = "bin/dashql-lint.mjs",
    visibility = ["//visibility:public"],
)

vitest_bin.vitest_test(
    name = "tests",
    size = "small",
    args = [
        "run",
        "--config",
        "vitest.config.ts",
    ],
    chdir = "packages/dashql-lint",
    data = [
        ":test_srcs",
        "vitest.config.ts",
        "//:node_modules/vitest",
    ] + _RUNTIME_DEPS,
)
