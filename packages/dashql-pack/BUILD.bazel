load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

_DEPS = [
    "@crates//:anyhow",
    "@crates//:aws-config",
    "@crates//:aws-credential-types",
    "@crates//:aws-sdk-s3",
    "@crates//:chrono",
    "@crates//:clap",
    "@crates//:env_logger",
    "@crates//:futures",
    "@crates//:git2",
    "@crates//:lazy_static",
    "@crates//:log",
    "@crates//:minisign",
    "@crates//:regex",
    "@crates//:semver",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:serde_with",
    "@crates//:tokio",
    "@crates//:uuid",
]

rust_binary(
    name = "pack",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    deps = _DEPS,
    visibility = ["//visibility:public"]
)

rust_test(
    name = "test",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    deps = _DEPS,
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "vacuum",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    args = [
        "vacuum",
    ],
    deps = _DEPS,
    visibility = ["//visibility:public"]
)
