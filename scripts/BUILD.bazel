load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

py_binary(
    name = "update_bazel_hashes",
    srcs = ["update_bazel_hashes.py"],
    main = "update_bazel_hashes.py",
)

# Re-resolve the crate universes of bazel/crates/*.MODULE.bazel and rewrite their Cargo.lock files.
# Usage: bazel run //scripts:repin_crates [-- full | <crate>@<version>]
sh_binary(
    name = "repin_crates",
    srcs = ["repin_crates.sh"],
)

# Generate rust-project.json for rust-analyzer, see docs/agents/rust_analyzer.md.
# Usage: bazel run //scripts:rust_project [-- <target patterns>]
py_binary(
    name = "rust_project",
    srcs = ["rust_project.py"],
    args = ["$(rlocationpath @rules_rust//tools/rust_analyzer:gen_rust_project)"],
    data = ["@rules_rust//tools/rust_analyzer:gen_rust_project"],
    main = "rust_project.py",
    deps = ["@rules_python//python/runfiles"],
)
