# Package for Bzlmod external_projects extension and build_file fragments.
exports_files([
    "external_bison.bzl",
    "external_duckdb_cli.BUILD",
    "external_m4.bzl",
    "macos_packaging.bzl",
])

# DuckDB CLI executable, selected per exec platform. Used as a build tool
# (exec config) by //packages/dashql-data for Parquet conversion genrules.
alias(
    name = "duckdb_cli",
    actual = select({
        "@platforms//os:macos": "@duckdb_cli_osx//:duckdb",
        "@platforms//os:linux": "@duckdb_cli_linux_amd64//:duckdb",
    }),
    visibility = ["//visibility:public"],
)
