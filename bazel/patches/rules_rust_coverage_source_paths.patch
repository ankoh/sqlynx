+// rules_rust copies all sources of a crate with generated sources into
+// bazel-out/<config>/bin, so llvm-cov reports them there. The LCOV merger only
+// keeps files of the instrumented files manifest, which lists them at their
+// source paths. Strip the bin directory to report them at their source paths.
+// Generated sources are not in the manifest and are still dropped.
+fn strip_bin_dirs(report: &str) -> String {
+    let mut out = String::with_capacity(report.len());
+    for line in report.lines() {
+        let source = line
+            .strip_prefix("SF:bazel-out/")
+            .and_then(|rest| rest.split_once('/'))
+            .and_then(|(_config, rest)| rest.strip_prefix("bin/"));
+        match source {
+            Some(path) => {
+                out.push_str("SF:");
+                out.push_str(path);
+            }
+            None => out.push_str(line),
+        }
+        out.push('\n');
+    }
+    out
+}
